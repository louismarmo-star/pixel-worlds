  "editorError.foreground": "#ff7a7a",
  "editorWarning.foreground": "#ffd870"
 },
 "semanticHighlighting": true,
 "tokenColors": [
  {
   "name": "Commentaires",
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#5f8fa8",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Mots-clés — corail",
   "scope": [
    "keyword",
    "storage.type",
    "storage.modifier",
    "keyword.control",
    "keyword.operator.new",
    "keyword.operator.expression"
   ],
   "settings": {
    "foreground": "#ff8a7a"
   }
  },
  {
   "name": "Fonctions — aqua",
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call entity.name.function"
   ],
   "settings": {
    "foreground": "#4df0ff"
   }
  },
  {
   "name": "Chaînes — écume",
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ],
   "settings": {
    "foreground": "#7dffc4"
   }
  },
  {
   "name": "Nombres — sable doré",
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.character.escape",
    "constant.other"
   ],
   "settings": {
    "foreground": "#ffd870"
   }
  },
  {
   "name": "Types",
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "storage.type.primitive",
    "entity.other.inherited-class"
   ],
   "settings": {
    "foreground": "#9ab8ff"
   }
  },
  {
   "name": "Variables",
   "scope": [
    "variable",
    "variable.other",
    "meta.definition.variable"
   ],
   "settings": {
    "foreground": "#e8faff"
   }
  },
  {
   "name": "Paramètres",
   "scope": [
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#ffd9b8"
   }
  },
  {
   "name": "Propriétés",
   "scope": [
    "variable.other.property",
    "support.variable.property",
    "meta.object-literal.key",
    "entity.name.tag.yaml",
    "support.type.property-name"
   ],
   "settings": {
    "foreground": "#8fd8ff"
   }
  },
  {
   "name": "Balises",
   "scope": [
    "entity.name.tag"
   ],
   "settings": {
    "foreground": "#ff8fb0"
   }
  },
  {
   "name": "Attributs",
   "scope": [
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#ffd870"
   }
  },
  {
   "name": "Opérateurs",
   "scope": [
    "keyword.operator",
    "punctuation"
   ],
   "settings": {
    "foreground": "#a8d4e8"
   }
  },
  {
   "name": "Imports",
   "scope": [
    "keyword.control.import",
    "keyword.control.from",
    "keyword.control.export"
   ],
   "settings": {
    "foreground": "#ff8a7a",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Préprocesseur C",
   "scope": [
    "meta.preprocessor",
    "keyword.control.directive",
    "entity.name.function.preprocessor"
   ],
   "settings": {
    "foreground": "#ff8fb0"
   }
  },
  {
   "name": "Titres Markdown",
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#4df0ff",
    "fontStyle": "bold"
   }
  }
 ]
}