 },
 "semanticHighlighting": true,
 "tokenColors": [
  {
   "name": "Commentaires",
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#6a72a8",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Mots-clés — violet nébuleuse",
   "scope": [
    "keyword",
    "storage.type",
    "storage.modifier",
    "keyword.control",
    "keyword.operator.new",
    "keyword.operator.expression"
   ],
   "settings": {
    "foreground": "#b48cff"
   }
  },
  {
   "name": "Fonctions — cyan",
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call entity.name.function"
   ],
   "settings": {
    "foreground": "#4df0ff"
   }
  },
  {
   "name": "Chaînes — vert",
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ],
   "settings": {
    "foreground": "#7dffa0"
   }
  },
  {
   "name": "Nombres — orange fusée",
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.character.escape",
    "constant.other"
   ],
   "settings": {
    "foreground": "#ff9a2e"
   }
  },
  {
   "name": "Types",
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "storage.type.primitive",
    "entity.other.inherited-class"
   ],
   "settings": {
    "foreground": "#8fb8ff"
   }
  },
  {
   "name": "Variables",
   "scope": [
    "variable",
    "variable.other",
    "meta.definition.variable"
   ],
   "settings": {
    "foreground": "#e6ebff"
   }
  },
  {
   "name": "Paramètres",
   "scope": [
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#ffd9a8"
   }
  },
  {
   "name": "Propriétés",
   "scope": [
    "variable.other.property",
    "support.variable.property",
    "meta.object-literal.key",
    "entity.name.tag.yaml",
    "support.type.property-name"
   ],
   "settings": {
    "foreground": "#9ad0ff"
   }
  },
  {
   "name": "Balises",
   "scope": [
    "entity.name.tag"
   ],
   "settings": {
    "foreground": "#ff77c5"
   }
  },
  {
   "name": "Attributs",
   "scope": [
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#ffe066"
   }
  },
  {
   "name": "Opérateurs",
   "scope": [
    "keyword.operator",
    "punctuation"
   ],
   "settings": {
    "foreground": "#a8b0e8"
   }
  },
  {
   "name": "Imports",
   "scope": [
    "keyword.control.import",
    "keyword.control.from",
    "keyword.control.export"
   ],
   "settings": {
    "foreground": "#b48cff",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Préprocesseur C",
   "scope": [
    "meta.preprocessor",
    "keyword.control.directive",
    "entity.name.function.preprocessor"
   ],
   "settings": {
    "foreground": "#ff77c5"
   }
  },
  {
   "name": "Titres Markdown",
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#ff9a2e",
    "fontStyle": "bold"
   }
  }
 ]
}