  "editorWidget.background": "#123826",
  "quickInput.background": "#123826",
  "gitDecoration.modifiedResourceForeground": "#f8c34a",
  "gitDecoration.untrackedResourceForeground": "#6fdc8c",
  "gitDecoration.deletedResourceForeground": "#ff6b6b",
  "editorError.foreground": "#ff5c5c",
  "editorWarning.foreground": "#f8c34a"
 },
 "semanticHighlighting": true,
 "tokenColors": [
  {
   "name": "Commentaires — gris givré",
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#7fa892",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Mots-clés — rouge Père Noël",
   "scope": [
    "keyword",
    "storage.type",
    "storage.modifier",
    "keyword.control",
    "keyword.operator.new",
    "keyword.operator.expression"
   ],
   "settings": {
    "foreground": "#ff5c5c"
   }
  },
  {
   "name": "Fonctions — or des étoiles",
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call entity.name.function"
   ],
   "settings": {
    "foreground": "#f8c34a"
   }
  },
  {
   "name": "Chaînes — vert sapin",
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ],
   "settings": {
    "foreground": "#b8f5c6"
   }
  },
  {
   "name": "Nombres et constantes — rose sucre d'orge",
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.character.escape",
    "constant.other"
   ],
   "settings": {
    "foreground": "#ff8ad8"
   }
  },
  {
   "name": "Types et classes — bleu glace",
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "storage.type.primitive",
    "entity.other.inherited-class"
   ],
   "settings": {
    "foreground": "#7cc4ff"
   }
  },
  {
   "name": "Variables — blanc neige",
   "scope": [
    "variable",
    "variable.other",
    "variable.parameter",
    "meta.definition.variable"
   ],
   "settings": {
    "foreground": "#e8f1f8"
   }
  },
  {
   "name": "Paramètres",
   "scope": [
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#ffd9b0"
   }
  },
  {
   "name": "Propriétés — bleu givre",
   "scope": [
    "variable.other.property",
    "support.variable.property",
    "meta.object-literal.key",
    "entity.name.tag.yaml",
    "support.type.property-name"
   ],
   "settings": {
    "foreground": "#a8d8ff"
   }
  },
  {
   "name": "Balises HTML — rouge",
   "scope": [
    "entity.name.tag"
   ],
   "settings": {
    "foreground": "#ff6b6b"
   }
  },
  {
   "name": "Attributs — or",
   "scope": [
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#f8c34a"
   }
  },
  {
   "name": "Opérateurs et ponctuation",
   "scope": [
    "keyword.operator",
    "punctuation"
   ],
   "settings": {
    "foreground": "#c6dccf"
   }
  },
  {
   "name": "Imports",
   "scope": [
    "keyword.control.import",
    "keyword.control.from",
    "keyword.control.export"
   ],
   "settings": {
    "foreground": "#ff8080",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Préprocesseur C",
   "scope": [
    "meta.preprocessor",
    "keyword.control.directive",
    "entity.name.function.preprocessor"
   ],
   "settings": {
    "foreground": "#ff8ad8"
   }
  },
  {
   "name": "Markdown titres",
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#f8c34a",
    "fontStyle": "bold"
   }
  }
 ]
}