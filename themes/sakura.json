  "focusBorder": "#ff8fbf",
  "button.background": "#c2487a",
  "button.hoverBackground": "#d65c90",
  "badge.background": "#c2487a",
  "input.background": "#17122b",
  "input.border": "#4a3a78",
  "dropdown.background": "#17122b",
  "editorWidget.background": "#2b2150",
  "quickInput.background": "#2b2150",
  "scrollbarSlider.background": "#ff8fbf30",
  "scrollbarSlider.hoverBackground": "#ff8fbf60",
  "gitDecoration.modifiedResourceForeground": "#ffd98a",
  "gitDecoration.untrackedResourceForeground": "#9be8d0",
  "gitDecoration.deletedResourceForeground": "#ff6b8e",
  "editorError.foreground": "#ff6b8e",
  "editorWarning.foreground": "#ffd98a"
 },
 "semanticHighlighting": true,
 "tokenColors": [
  {
   "name": "Commentaires",
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#8a7aa8",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Mots-clés — rose sakura",
   "scope": [
    "keyword",
    "storage.type",
    "storage.modifier",
    "keyword.control",
    "keyword.operator.new",
    "keyword.operator.expression"
   ],
   "settings": {
    "foreground": "#ff8fbf"
   }
  },
  {
   "name": "Fonctions — or",
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call entity.name.function"
   ],
   "settings": {
    "foreground": "#ffd98a"
   }
  },
  {
   "name": "Chaînes — matcha",
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ],
   "settings": {
    "foreground": "#9be8d0"
   }
  },
  {
   "name": "Nombres — pêche",
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.character.escape",
    "constant.other"
   ],
   "settings": {
    "foreground": "#ff9d6c"
   }
  },
  {
   "name": "Types",
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "storage.type.primitive",
    "entity.other.inherited-class"
   ],
   "settings": {
    "foreground": "#9ec5ff"
   }
  },
  {
   "name": "Variables",
   "scope": [
    "variable",
    "variable.other",
    "meta.definition.variable"
   ],
   "settings": {
    "foreground": "#fff0f6"
   }
  },
  {
   "name": "Paramètres",
   "scope": [
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#ffd9c4"
   }
  },
  {
   "name": "Propriétés",
   "scope": [
    "variable.other.property",
    "support.variable.property",
    "meta.object-literal.key",
    "entity.name.tag.yaml",
    "support.type.property-name"
   ],
   "settings": {
    "foreground": "#c9b6ff"
   }
  },
  {
   "name": "Balises",
   "scope": [
    "entity.name.tag"
   ],
   "settings": {
    "foreground": "#ff7aa8"
   }
  },
  {
   "name": "Attributs",
   "scope": [
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#ffd98a"
   }
  },
  {
   "name": "Opérateurs",
   "scope": [
    "keyword.operator",
    "punctuation"
   ],
   "settings": {
    "foreground": "#c8b4e0"
   }
  },
  {
   "name": "Imports",
   "scope": [
    "keyword.control.import",
    "keyword.control.from",
    "keyword.control.export"
   ],
   "settings": {
    "foreground": "#ff8fbf",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Préprocesseur C",
   "scope": [
    "meta.preprocessor",
    "keyword.control.directive",
    "entity.name.function.preprocessor"
   ],
   "settings": {
    "foreground": "#ff7aa8"
   }
  },
  {
   "name": "Titres Markdown",
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#ff8fbf",
    "fontStyle": "bold"
   }
  }
 ]
}