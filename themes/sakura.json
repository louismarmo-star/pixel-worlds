  "terminal.background": "#17122b",
  "terminal.foreground": "#fff0f6",
  "terminalCursor.foreground": "#ff8fbf",
  "terminal.ansiBlack": "#3a2a60",
  "terminal.ansiRed": "#ff6b8e",
  "terminal.ansiGreen": "#9be8d0",
  "terminal.ansiYellow": "#ffd98a",
  "terminal.ansiBlue": "#9ec5ff",
  "terminal.ansiMagenta": "#ff8fbf",
  "terminal.ansiCyan": "#8fe8ff",
  "terminal.ansiWhite": "#fff0f6",
  "terminal.ansiBrightBlack": "#8a7aa8",
  "terminal.ansiBrightRed": "#ff93ab",
  "terminal.ansiBrightGreen": "#c0f5e6",
