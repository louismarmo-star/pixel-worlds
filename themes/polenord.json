  "editorError.foreground": "#ff7b8a",
  "editorWarning.foreground": "#ffd98a"
 },
 "semanticHighlighting": true,
 "tokenColors": [
  {
   "name": "Commentaires",
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#6f9bc4",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Mots-clés — violet aurore",
   "scope": [
    "keyword",
    "storage.type",
    "storage.modifier",
    "keyword.control",
    "keyword.operator.new",
    "keyword.operator.expression"
   ],
   "settings": {
    "foreground": "#c89cff"
   }
  },
  {
   "name": "Fonctions — vert aurore",
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call entity.name.function"
   ],
   "settings": {
    "foreground": "#6cf0b0"
   }
  },
  {
   "name": "Chaînes — cyan glacé",
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ],
   "settings": {
    "foreground": "#9cf0ff"
   }
  },
  {
   "name": "Nombres — orange bec de pingouin",
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.character.escape",
    "constant.other"
   ],
   "settings": {
    "foreground": "#ffb86c"
   }
  },
  {
   "name": "Types",
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "storage.type.primitive",
    "entity.other.inherited-class"
   ],
   "settings": {
    "foreground": "#7fd0ff"
   }
  },
  {
   "name": "Variables",
   "scope": [
    "variable",
    "variable.other",
    "meta.definition.variable"
   ],
   "settings": {
    "foreground": "#eaf6ff"
   }
  },
  {
   "name": "Paramètres",
   "scope": [
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#ffe0b0"
   }
  },
  {
   "name": "Propriétés",
   "scope": [
    "variable.other.property",
    "support.variable.property",
    "meta.object-literal.key",
    "entity.name.tag.yaml",
    "support.type.property-name"
   ],
   "settings": {
    "foreground": "#a8d8ff"
   }
  },
  {
   "name": "Balises",
   "scope": [
    "entity.name.tag"
   ],
   "settings": {
    "foreground": "#ff9cc8"
   }
  },
  {
   "name": "Attributs",
   "scope": [
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#ffd98a"
   }
  },
  {
   "name": "Opérateurs",
   "scope": [
    "keyword.operator",
    "punctuation"
   ],
   "settings": {
    "foreground": "#a8c8e8"
   }
  },
  {
   "name": "Imports",
   "scope": [
    "keyword.control.import",
    "keyword.control.from",
    "keyword.control.export"
   ],
   "settings": {
    "foreground": "#c89cff",
    "fontStyle": "italic"
   }
  },
  {
   "name": "Préprocesseur C",
   "scope": [
    "meta.preprocessor",
    "keyword.control.directive",
    "entity.name.function.preprocessor"
   ],
   "settings": {
    "foreground": "#ff9cc8"
   }
  },
  {
   "name": "Titres Markdown",
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#7fe0ff",
    "fontStyle": "bold"
   }
  }
 ]
}